<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <RootNamespace>FCP.Core</RootNamespace>
        <AssemblyName>FCP_Core</AssemblyName>
        <AssemblyTitle>Fallout Core Module</AssemblyTitle>
        <LangVersion>14.0</LangVersion>
        <OutDir>..\..\..\Current\Assemblies\</OutDir>
    </PropertyGroup>
    <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
        <DebugSymbols>true</DebugSymbols>
        <Optimize>true</Optimize>
        <DebugType>embedded</DebugType>
        <DefineConstants>DEBUG;</DefineConstants>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
        <DebugSymbols>false</DebugSymbols>
        <Optimize>true</Optimize>
        <DebugType>embedded</DebugType>
    </PropertyGroup>

    <!-- Makes FCP.Core.Logging available project-wide without explicit using directives -->
    <ItemGroup>
        <Using Include="FCP.Core.Logging"/>
    </ItemGroup>
</Project>
