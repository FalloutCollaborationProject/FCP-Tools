<?xml version="1.0" encoding="utf-8"?>
<Defs>

    <!--__________ Synth Components __________-->

    <ThingDef ParentName="ResourceBase">
        <defName>FCP_SynthComponents</defName>
        <label>synth components</label>
        <description>A tangle of synthetic muscle fiber and hardened circuitry, unmistakably artificial. Whoever wore it wasn't entirely human.</description>
        <graphicData>
            <texPath>FCP_Synth/Items/FCP_SynthComponents</texPath>
            <graphicClass>Graphic_StackCount</graphicClass>
        </graphicData>
        <soundInteract>Metal_Drop</soundInteract>
        <soundDrop>Standard_Drop</soundDrop>
        <stackLimit>25</stackLimit>
        <healthAffectsPrice>false</healthAffectsPrice>
        <statBases>
            <MaxHitPoints>60</MaxHitPoints>
            <MarketValue>45</MarketValue>
            <Mass>0.3</Mass>
            <Flammability>0.4</Flammability>
            <DeteriorationRate>2.0</DeteriorationRate>
        </statBases>
        <intricate>true</intricate>
        <thingCategories>
            <li>Manufactured</li>
        </thingCategories>
    </ThingDef>

</Defs>
