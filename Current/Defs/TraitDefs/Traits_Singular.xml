<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!--__________ Traits __________-->

    <!--_____ Singular _____-->

    <!-- Power Armor Trained -->

    <TraitDef>
        <defName>FCP_Trait_Power_Armor_Trained</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Power Armor Trained</label>
                <description>{PAWN_nameDef} has completed basic power armor training. {PAWN_pronoun} is ready to take on the wasteland in any suit of power armor they see fit.</description>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Toughness -->

    <TraitDef>
        <defName>FCP_Trait_Tough</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Toughness</label>
                <description>{PAWN_nameDef} is exceptionally tough, taking less damage from all sources.</description>
                <statOffsets>
                    <ArmorRating_Sharp>0.10</ArmorRating_Sharp>
                    <ArmorRating_Blunt>0.10</ArmorRating_Blunt>
                    <ArmorRating_Heat>0.10</ArmorRating_Heat>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Fast Metabolism (FO1/2/NV trait) - faster healing, but rad and poison resistance suffer -->

    <TraitDef>
        <defName>FCP_Trait_Fast_Metabolism</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Fast Metabolism</label>
                <description>{PAWN_nameDef} heals wounds and shakes off disease faster than most, but their body has no reserves left to resist toxins or radiation.</description>
                <statOffsets>
                    <InjuryHealingFactor>0.25</InjuryHealingFactor>
                    <ImmunityGainSpeed>0.20</ImmunityGainSpeed>
                    <ToxicResistance>-0.30</ToxicResistance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Sniper (NV perk) -->

    <TraitDef>
        <defName>FCP_Trait_Sharpshooter</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Sniper</label>
                <description>{PAWN_nameDef} has a gift for placing shots exactly where they need to go, rarely missing at range.</description>
                <statOffsets>
                    <ShootingAccuracyPawn>0.12</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Heavy Handed (FO1/2/NV trait) - harder hits, weaker precision -->

    <TraitDef>
        <defName>FCP_Trait_Heavy_Handed</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Heavy Handed</label>
                <description>{PAWN_nameDef} swings and strikes with real force, but overcommits, leaving {PAWN_objective} easier to dodge or block.</description>
                <statOffsets>
                    <MeleeDamageFactor>0.20</MeleeDamageFactor>
                    <MeleeHitChance>-0.12</MeleeHitChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Fast Shot (FNV trait) - fires faster, but far less accurate -->

    <TraitDef>
        <defName>FCP_Trait_Quick_Draw</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Fast Shot</label>
                <description>{PAWN_nameDef} snaps off shots and draws weapons quickly without lining up the shot, trading accuracy for speed.</description>
                <statOffsets>
                    <AimingDelayFactor>-0.20</AimingDelayFactor>
                    <ShootingAccuracyPawn>-0.15</ShootingAccuracyPawn>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Night Person (FO1/2/NV trait) - sharper at night, duller by day -->

    <TraitDef>
        <defName>FCP_Trait_Night_Person</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Night Person</label>
                <description>{PAWN_nameDef} thinks and shoots straighter after dark, and is noticeably duller during the day.</description>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Bloody Mess (FO1/2/3/NV trait) - purely cosmetic, no combat benefit -->

    <TraitDef>
        <defName>FCP_Trait_Bloody_Mess</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Bloody Mess</label>
                <description>Everything {PAWN_nameDef} kills comes apart at the seams - limbs gone, viscera everywhere. It has no bearing on {PAWN_possessive} combat ability whatsoever - {PAWN_pronoun} is just unlucky like that.</description>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Lead Belly (FO3/NV/4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Lead_Belly</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Lead Belly</label>
                <description>{PAWN_nameDef} has learned the hard way how to keep food and water safe to consume, rarely spoiling a meal {PAWN_pronoun} prepares.</description>
                <statOffsets>
                    <FoodPoisonChance>-0.35</FoodPoisonChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Iron Fist (FO4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Iron_Fist</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Iron Fist</label>
                <description>{PAWN_nameDef} is skilled in unarmed combat, dealing more damage with fists.</description>
                <statOffsets>
                    <MeleeDamageFactor>0.15</MeleeDamageFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Swift Learner (FO3/NV/4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Swift_Learner</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Swift Learner</label>
                <description>{PAWN_nameDef} learns skills faster than most.</description>
                <statOffsets>
                    <GlobalLearningFactor>0.20</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Action Boy/Girl (FO3/NV perk) -->

    <TraitDef>
        <defName>FCP_Trait_Action_Boy</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Action Boy/Girl</label>
                <description>{PAWN_nameDef} recovers stamina and energy quickly, allowing for more actions in a day.</description>
                <statOffsets>
                    <RestRateMultiplier>0.15</RestRateMultiplier>
                    <MoveSpeed>0.05</MoveSpeed>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Fortune Finder (NV/4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Fortune_Finder</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Fortune Finder</label>
                <description>{PAWN_nameDef} always seems to find more silver and valuables.</description>
                <statOffsets>
                    <TradePriceImprovement>0.10</TradePriceImprovement>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Animal Friend (FO3/NV/4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Animal_Friend</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Animal Friend</label>
                <description>{PAWN_nameDef} is naturally good with animals, calming and winning over even wild and skittish ones.</description>
                <statOffsets>
                    <AnimalGatherYield>0.15</AnimalGatherYield>
                    <TameAnimalChance>0.15</TameAnimalChance>
                    <TrainAnimalChance>0.15</TrainAnimalChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Commando (NV/4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Commando</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Commando</label>
                <description>{PAWN_nameDef} is skilled with automatic weapons, firing more accurately and faster.</description>
                <statOffsets>
                    <ShootingAccuracyPawn>0.07</ShootingAccuracyPawn>
                    <AimingDelayFactor>-0.10</AimingDelayFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Gunslinger (NV/4 perk) -->

    <TraitDef>
        <defName>FCP_Trait_Gunslinger</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Gunslinger</label>
                <description>{PAWN_nameDef} is deadly with pistols and one-handed firearms.</description>
                <statOffsets>
                    <ShootingAccuracyPawn>0.08</ShootingAccuracyPawn>
                    <AimingDelayFactor>-0.08</AimingDelayFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Scrounger (NV perk) -->

    <TraitDef>
        <defName>FCP_Trait_Scrounger</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Scrounger</label>
                <description>{PAWN_nameDef} has a knack for finding usable salvage that everyone else walks past.</description>
                <statOffsets>
                    <PlantHarvestYield>0.10</PlantHarvestYield>
                    <MiningYield>0.10</MiningYield>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Solar Powered (NV/4 perk) - only helps outdoors during the day -->

    <TraitDef>
        <defName>FCP_Trait_Solar_Powered</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Solar Powered</label>
                <description>The sun puts a spring in {PAWN_nameDef}'s step. Standing under open sky between dawn and dusk speeds {PAWN_possessive} recovery; it does nothing indoors or after dark.</description>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- Rad Resistance (NV perk) -->

    <TraitDef>
        <defName>FCP_Trait_Rad_Resistant</defName>
        <commonality>1</commonality>
        <degreeDatas>
            <li>
                <label>Rad Resistance</label>
                <description>{PAWN_nameDef} is unusually resistant to radiation and toxins.</description>
                <statOffsets>
                    <ToxicResistance>0.25</ToxicResistance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

</Defs>
